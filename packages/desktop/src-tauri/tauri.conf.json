{
  "$schema": "https://raw.githubusercontent.com/nicholasrice/tauri-2-schema/refs/heads/main/tauri.conf.2.json",
  "productName": "Sketch",
  "version": "0.1.0",
  "identifier": "dev.sketch.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run build:sidecar && npm run dev",
    "beforeBuildCommand": "npm run build:sidecar && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Sketch",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' ws: http: https:;"
    }
  },
  "bundle": {
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "externalBin": ["binaries/sketch-engine"],
    "resources": ["resources/sketch-engine.mjs"]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
