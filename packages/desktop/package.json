{
  "name": "@sketch/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "verify:sidecar": "node scripts/verify-sidecar.mjs",
    "preflight:ollama": "node scripts/preflight-ollama.mjs",
    "package": "tauri build",
    "package:windows": "tauri build --bundles nsis",
    "package:macos": "tauri build --bundles dmg",
    "package:linux": "tauri build --bundles appimage",
    "package:size": "node scripts/check-package-size.mjs",
    "release:assemble": "node scripts/assemble-release.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-fs": "^2.2.0",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "monaco-editor": "0.52.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@sketch/core": "*",
    "@tauri-apps/cli": "^2.5.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.2",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "vite": "^6.3.5",
    "vitest": "^2.1.8"
  }
}
