{
  "name": "sketch",
  "version": "0.1.0",
  "private": true,
  "description": "Sketch — local-first engineering OS: one desktop window over one dependency-free engine",
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "build:core": "npm run build -w @sketch/core",
    "test:core": "npm run test -w @sketch/core",
    "typecheck:core": "npm run typecheck -w @sketch/core",
    "bench": "npm run build -w @sketch/core && npm run bench -w @sketch/core",
    "bench:check": "npm run build -w @sketch/core && npm run bench:check -w @sketch/core",
    "build:desktop": "npm run build -w @sketch/desktop",
    "dev:desktop": "npm run dev -w @sketch/desktop"
  }
}
